POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASS=postgres

AUTH_DB=chatvardage_auth
ROOMS_DB=chatvardage_rooms
MESSAGES_DB=chatvardage_messages
CONFIG_DB=chatvardage_config

AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=auth_service_dev
ROOMS_DB_USER=room_service
ROOMS_DB_PASSWORD=room_service_dev
MESSAGES_DB_USER=message_service
MESSAGES_DB_PASSWORD=message_service_dev
CONFIG_DB_USER=config_service
CONFIG_DB_PASSWORD=config_service_dev

REDIS_PASSWORD=chatvardage_redis_dev

# Contrat temporaire entre Auth et les services qui valident les JWT HS256.
# Garder la meme valeur dans Auth et Message-Service tant que ce contrat est utilise.
# Si Auth change de mecanisme, adapter ces variables et les validateurs ensemble.
JWT_SECRET=change-me-minimum-32-characters-long
CORS_ORIGINS=http://localhost:5173
